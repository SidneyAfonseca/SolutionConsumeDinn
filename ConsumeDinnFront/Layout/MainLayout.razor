@inherits LayoutComponentBase
@inject DinnApiClient Api
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center gap-3">
            <AuthorizeView>
                <Authorized>
                    <span class="text-muted small">
                        @context.User.Identity?.Name
                        <span class="badge bg-secondary ms-1">@PerfilDe(context.User)</span>
                    </span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Sair">Sair</button>
                </Authorized>
                <NotAuthorized>
                    <a href="login">Entrar</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task Sair()
    {
        await Api.LogoutAsync();
        Navigation.NavigateTo("login");
    }

    private static string PerfilDe(System.Security.Claims.ClaimsPrincipal user) =>
        user.IsInRole("Admin") ? "Admin" : "UserNormal";
}
