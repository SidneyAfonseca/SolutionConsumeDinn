@page "/"

<PageTitle>D-inn Manager</PageTitle>

<h1>D-inn Manager</h1>

<AuthorizeView>
    <Authorized>
        <p>Olá, @context.User.Identity?.Name.</p>
        <ul>
            <li><a href="envios">Envios D-IN</a> — histórico dos envios e quem os disparou.</li>
            <li><a href="departments">Departamentos</a> e <a href="accountplans">Plano de Contas</a> — dados do guia D-IN v4.1.</li>
        </ul>
        <AuthorizeView Roles="Admin" Context="admin">
            <Authorized>
                <p><a href="users">Administração de Usuários</a> — criar usuários, trocar perfis e desabilitar acessos.</p>
            </Authorized>
        </AuthorizeView>
    </Authorized>
    <NotAuthorized>
        <p>Faça <a href="login">login</a> para continuar.</p>
    </NotAuthorized>
</AuthorizeView>
